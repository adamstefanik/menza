@using UTB.Minute.AdminClient.Services
@using Microsoft.AspNetCore.Authentication
@inherits LayoutComponentBase
@inject IJSRuntime JS
@inject TokenProvider TokenProvider
@inject PersistentComponentState ApplicationState
@implements IDisposable

<PageTitle>UTB minute - Administrácia</PageTitle>

<div class="wk-header">
    <div class="d-flex align-items-center">
        <div class="wk-brand">UTB minute</div>
        <nav class="wk-nav-top">
            <a href="/" class="wk-nav-link">Administrácia</a>
        </nav>
    </div>
    <div class="wk-user-box">
        <AuthorizeView>
            <Authorized>
                <span class="text-white small">Užívateľ: <strong>@context.User.Identity?.Name</strong></span>
                <a href="/logout" class="btn btn-sm btn-outline-light py-0" data-enhance-nav="false">Odhlásiť</a>
            </Authorized>
            <NotAuthorized>
                <a href="/login" class="btn btn-sm btn-outline-light py-0" data-enhance-nav="false">Prihlásiť</a>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>

<div class="wk-layout">
    <aside class="wk-sidebar">
        <NavMenu />
    </aside>

    <main class="wk-main">
        <div class="content-card shadow-sm border rounded bg-white p-4">
            @Body
        </div>
    </main>
</div>

@code {
    private string? cachedToken;
    private PersistingComponentStateSubscription _subscription;

    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _subscription = ApplicationState.RegisterOnPersisting(PersistToken);

        if (ApplicationState.TryTakeFromJson<string>("access_token", out var restoredToken))
        {
            cachedToken = restoredToken;
        }

        if (string.IsNullOrEmpty(cachedToken) && HttpContext is not null)
        {
            cachedToken = await HttpContext.GetTokenAsync("access_token");
        }

        if (!string.IsNullOrEmpty(cachedToken))
        {
            TokenProvider.AccessToken = cachedToken;
        }
    }

    private Task PersistToken()
    {
        ApplicationState.PersistAsJson("access_token", cachedToken);
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        _subscription.Dispose();
    }
}

<div id="blazor-error-ui" data-nosnippet>
    Vyskytla sa chyba.
    <a href="." class="reload">Obnoviť</a>
    <span class="dismiss">🗙</span>
</div>
