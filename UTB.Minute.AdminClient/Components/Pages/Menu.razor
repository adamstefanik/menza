@page "/menu"
@using UTB.Minute.AdminClient.Services
@using UTB.Minute.Contracts
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "admin")]
@inject IMenuClient MenuClient
@inject NavigationManager Nav

<div class="wk-tabs">
    <div class="wk-tab active">Správa menu</div>
    <div class="ms-auto">
        @if (Date != null)
        {
            <button class="btn btn-outline-secondary btn-sm me-2" @onclick='() => Nav.NavigateTo("/menu")'>Zobraziť všetko</button>
        }
        <a href="/add-menu-item" class="btn btn-success btn-sm">+ Pridať do menu</a>
    </div>
</div>

@if (filteredMenu == null)
{
    <p>Načítavam...</p>
}
else
{
    @if (Date == null && todayMenu != null && todayMenu.Any())
    {
        <div class="fw-bold text-muted small mb-2 uppercase">Dnešné menu</div>
        <table class="table mb-5">
            <thead>
                <tr>
                    @if (Date == null)
                    {
                        <th style="width: 100px;"></th>
                    }
                    <th>Jedlo</th>
                    <th class="text-center" style="width: 150px;">Dostupné porcie</th>
                    <th class="text-end"><div class="d-inline-block text-center" style="width: 180px;">Akcia</div></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in todayMenu)
                {
                    <tr>
                        @if (Date == null)
                        {
                            <td></td>
                        }
                        <td>
                            <div>@item.MealDescription</div>
                            @if (!string.IsNullOrEmpty(item.Allergens))
                            {
                                <div class="small text-muted">Alergény: @item.Allergens</div>
                            }
                        </td>
                        <td class="text-center">@item.AvailablePortions</td>
                        <td class="text-end">
                            <div class="d-inline-block text-center" style="width: 180px;">
                                <a href="/edit-menu-item/@item.Id" class="btn btn-secondary btn-sm me-1">Upraviť</a>
                                <button class="btn btn-danger btn-sm" @onclick="() => Delete(item.Id)">Zmazať</button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <div class="fw-bold text-muted small mb-2 uppercase">Položky menu</div>
    <table class="table">
        <thead>
            <tr>
                @if (Date == null)
                {
                    <th style="width: 100px;">Dátum</th>
                }
                <th>Jedlo</th>
                <th class="text-center" style="width: 150px;">Dostupné porcie</th>
                <th class="text-end"><div class="d-inline-block text-center" style="width: 180px;">Akcia</div></th>
            </tr>
        </thead>
        <tbody>
            @if (!filteredMenu.Any())
            {
                <tr><td colspan="4" class="text-center p-4">Pre tento deň nie sú v menu žiadne záznamy.</td></tr>
            }
            @foreach (var item in filteredMenu.OrderBy(m => m.Date))
            {
                <tr>
                    @if (Date == null)
                    {
                        <td>@item.Date.ToString("dd.MM.yyyy")</td>
                    }
                    <td>
                        <div>@item.MealDescription</div>
                        @if (!string.IsNullOrEmpty(item.Allergens))
                        {
                            <div class="small text-muted">Alergény: @item.Allergens</div>
                        }
                    </td>
                    <td class="text-center">@item.AvailablePortions</td>
                    <td class="text-end">
                        <div class="d-inline-block text-center" style="width: 180px;">
                            <a href="/edit-menu-item/@item.Id" class="btn btn-secondary btn-sm me-1">Upraviť</a>
                            <button class="btn btn-danger btn-sm" @onclick="() => Delete(item.Id)">Zmazať</button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public string? Date { get; set; }

    private List<MenuItemDto>? todayMenu;
    private List<MenuItemDto>? allMenu;
    private List<MenuItemDto>? filteredMenu;

    private string DisplayDate => DateOnly.TryParse(Date, out var d) ? d.ToString("dd.MM.yyyy") : "";

    protected override async Task OnInitializedAsync() => await LoadData();

    protected override async Task OnParametersSetAsync()
    {
        await ApplyFilter();
    }

    private async Task LoadData()
    {
        var today = await MenuClient.GetTodayMenuAsync();
        todayMenu = today?.ToList();

        var all = await MenuClient.GetMenuItemsAsync();
        allMenu = all?.ToList();

        await ApplyFilter();
    }

    private Task ApplyFilter()
    {
        if (allMenu == null) return Task.CompletedTask;

        if (DateOnly.TryParse(Date, out var targetDate))
        {
            filteredMenu = allMenu.Where(m => m.Date == targetDate).ToList();
        }
        else
        {
            filteredMenu = allMenu;
        }

        return Task.CompletedTask;
    }

    private async Task Delete(int id)
    {
        await MenuClient.DeleteMenuItemAsync(id);
        await LoadData();
    }
}
