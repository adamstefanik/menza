@page "/add-menu-item"
@using UTB.Minute.AdminClient.Services
@using UTB.Minute.Contracts
@inject IMenuClient MenuClient
@inject IMealClient MealClient
@inject NavigationManager Nav

@rendermode InteractiveServer

<PageTitle>Pridať do menu</PageTitle>

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-success text-white">
            <h3 class="mb-0">Pridať jedlo do menu</h3>
        </div>
        <div class="card-body">
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger">@errorMessage</div>
            }

            @if (meals == null)
            {
                <p>Načítavam jedlá...</p>
            }
            else
            {
                <EditForm Model="@formModel" OnValidSubmit="HandleSave" FormName="AddMenuItemForm">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Jedlo:</label>
                        <InputSelect class="form-select" @bind-Value="formModel.MealId">
                            <option value="">-- Vyber jedlo --</option>
                            @foreach (var meal in meals.Where(m => m.IsActive))
                            {
                                <option value="@meal.Id">@meal.Description (@meal.Price.ToString("F2") €)</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Dátum:</label>
                        <InputDate class="form-control" @bind-Value="formModel.Date" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Dostupné porcie:</label>
                        <InputNumber class="form-control" @bind-Value="formModel.AvailablePortions" min="1" />
                    </div>

                    <div class="d-flex gap-2 border-top pt-3">
                        <button type="submit" class="btn btn-primary">Pridať do menu</button>
                        <button type="button" class="btn btn-outline-secondary" @onclick='() => Nav.NavigateTo("/menu")'>Zrušiť</button>
                    </div>
                </EditForm>
            }
        </div>
    </div>
</div>

@code {
    private List<MealDto>? meals;
    private FormModel formModel = new() { Date = DateTime.Today, AvailablePortions = 10 };
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await MealClient.GetMealsAsync();
            meals = result?.ToList();
        }
        catch (Exception ex)
        {
            errorMessage = $"Chyba pri načítaní jedál: {ex.Message}";
        }
    }

    private async Task HandleSave()
    {
        errorMessage = null;

        if (formModel.MealId == 0)
        {
            errorMessage = "Vyber jedlo!";
            return;
        }

        try 
        {
            var dto = new CreateMenuItemDto(
                DateOnly.FromDateTime(formModel.Date), 
                formModel.AvailablePortions, 
                formModel.MealId);
                
            await MenuClient.CreateMenuItemAsync(dto);
            Nav.NavigateTo("/menu");
        }
        catch (Exception ex)
        {
            errorMessage = $"Chyba pri ukladaní: {ex.Message}";
            Console.WriteLine(errorMessage);
        }
    }

    private class FormModel 
    {
        public int MealId { get; set; }
        public DateTime Date { get; set; } = DateTime.Today;
        public int AvailablePortions { get; set; } = 10;
    }
}