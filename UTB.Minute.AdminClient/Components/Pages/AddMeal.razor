@page "/add-meal"
@using UTB.Minute.AdminClient.Services
@using UTB.Minute.Contracts
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "admin")]
@inject IMealClient MealClient
@inject NavigationManager Nav

@rendermode InteractiveServer

<PageTitle>Pridať jedlo</PageTitle>

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-success text-white">
            <h3 class="mb-0">Nové jedlo do ponuky</h3>
        </div>
        <div class="card-body">
            
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger">@errorMessage</div>
            }

            <EditForm Model="@formModel" OnValidSubmit="HandleSave" FormName="AddMealForm">
                <div class="mb-3">
                    <label class="form-label fw-bold">Názov/Popis jedla:</label>
                    <InputText class="form-control" @bind-Value="formModel.Description" placeholder="napr. Kurací rezeň s kašou" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Alergény:</label>
                    <InputText class="form-control" @bind-Value="formModel.Allergens" placeholder="napr. 1, 3, 7" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Cena (€):</label>
                    <InputNumber class="form-control" @bind-Value="formModel.Price" />
                </div>

                <div class="d-flex gap-2 border-top pt-3">
                    <button type="submit" class="btn btn-primary">Uložiť jedlo</button>
                    <button type="button" class="btn btn-outline-secondary" @onclick='() => Nav.NavigateTo("/")'>Zrušiť</button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private FormModel formModel = new();
    private string? errorMessage;

    private async Task HandleSave()
    {
        errorMessage = null;
        
        try 
        {
            var newMeal = new MealDto(0, formModel.Description, formModel.Allergens, formModel.Price, true);
            await MealClient.CreateMealAsync(newMeal);
            Nav.NavigateTo("/");
        }
        catch (Exception ex)
        {
            errorMessage = $"Chyba pri ukladaní: {ex.Message}";
            Console.WriteLine(errorMessage);
        }
    }

    private class FormModel 
    {
        public string Description { get; set; } = "";
        public string? Allergens { get; set; }
        public decimal Price { get; set; } = 0;
    }
}
