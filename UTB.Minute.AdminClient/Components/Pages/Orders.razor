@page "/orders"
@using UTB.Minute.AdminClient.Services
@using UTB.Minute.Contracts
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "admin,cook")]
@inject IOrderClient OrderClient
@inject TokenProvider TokenProvider
@inject SseClientService SseClientService
@inject PersistentComponentState ApplicationState
@implements IDisposable

<div class="wk-tabs">
    <div class="wk-tab active">Správa objednávok</div>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (orders == null)
{
    <p>Načítavam...</p>
}
else if (!orders.Any())
{
    <div class="alert alert-info">Žiadne objednávky.</div>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Jedlo</th>
                <th>Stav</th>
                <th>Dátum</th>
                <th>Akcia</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in orders)
            {
                <tr>
                    <td>@order.Id</td>
                    <td>
                        <div>@order.MealDescription</div>
                        @if (!string.IsNullOrEmpty(order.Allergens))
                        {
                            <div class="small text-muted">Alergény: @order.Allergens</div>
                        }
                    </td>
                    <td>
                        <span class="badge @GetStatusClass(order.Status)">@GetStatusLabel(order.Status)</span>
                    </td>
                    <td>@order.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                    <td>
                        @if (order.Status == "Preparing")
                        {
                            <button class="btn btn-success btn-sm" @onclick='() => UpdateStatus(order.Id, "Ready")'>Pripravené</button>
                            <button class="btn btn-danger btn-sm" @onclick='() => UpdateStatus(order.Id, "Cancelled")'>Zrušiť</button>
                        }
                        else if (order.Status == "Ready")
                        {
                            <button class="btn btn-success btn-sm" @onclick='() => UpdateStatus(order.Id, "Completed")'>Dokončiť</button>
                        }
                        else if (order.Status == "Completed")
                        {
                            <span class="text-muted">Dokončená</span>
                        }
                        else if (order.Status == "Cancelled")
                        {
                            <span class="text-muted">Zrušená</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<OrderDto>? orders;
    private string? errorMessage;
    private string? cachedToken;
    private PersistingComponentStateSubscription _subscription;

    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _subscription = ApplicationState.RegisterOnPersisting(PersistToken);

        if (ApplicationState.TryTakeFromJson<string>("access_token", out var restoredToken))
        {
            cachedToken = restoredToken;
        }

        if (string.IsNullOrEmpty(cachedToken) && HttpContext is not null)
        {
            cachedToken = await HttpContext.GetTokenAsync("access_token");
        }

        if (!string.IsNullOrEmpty(cachedToken))
        {
            TokenProvider.AccessToken = cachedToken;
        }

        SseClientService.OnNotificationReceived += OnNotification;
        await SseClientService.StartAsync();
        await LoadData();
    }

    private Task PersistToken()
    {
        ApplicationState.PersistAsJson("access_token", cachedToken);
        return Task.CompletedTask;
    }

    private void OnNotification()
    {
        InvokeAsync(async () =>
        {
            await LoadData();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        _subscription.Dispose();
        SseClientService.OnNotificationReceived -= OnNotification;
    }

    private async Task LoadData()
    {
        var result = await OrderClient.GetOrdersAsync();
        orders = result?.ToList();
    }

    private async Task UpdateStatus(int id, string status)
    {
        try
        {
            await OrderClient.UpdateOrderStatusAsync(id, new UpdateOrderStatusDto(status));
            await LoadData();
        }
        catch (Exception ex)
        {
            errorMessage = $"Chyba: {ex.Message}";
        }
    }

    private string GetStatusClass(string status) => status switch
    {
        "Preparing" => "bg-secondary text-white",
        "Ready" => "bg-success text-white",
        "Completed" => "bg-success text-white",
        "Cancelled" => "bg-danger text-white",
        _ => "bg-secondary text-white"
    };

    private string GetStatusLabel(string status) => status switch
    {
        "Preparing" => "Pripravuje sa",
        "Ready" => "Hotové",
        "Completed" => "Dokončené",
        "Cancelled" => "Zrušené",
        _ => status
    };
}
