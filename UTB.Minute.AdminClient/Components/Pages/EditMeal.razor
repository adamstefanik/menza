@page "/edit-meal/{id:int}"
@using UTB.Minute.AdminClient.Services
@using UTB.Minute.Contracts
@inject IMealClient MealClient
@inject NavigationManager Nav

@rendermode InteractiveServer

<PageTitle>Upraviť jedlo</PageTitle>

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-warning text-dark">
            <h3 class="mb-0">Upraviť jedlo</h3>
        </div>
        <div class="card-body">
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger">@errorMessage</div>
            }

            @if (meal == null)
            {
                <p>Načítavam...</p>
            }
            else
            {
                <EditForm Model="@formModel" OnValidSubmit="HandleSave" FormName="EditMealForm">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Názov/Popis jedla:</label>
                        <InputText class="form-control" @bind-Value="formModel.Description" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Cena (€):</label>
                        <InputNumber class="form-control" @bind-Value="formModel.Price" />
                    </div>

                    <div class="mb-3 form-check">
                        <InputCheckbox class="form-check-input" @bind-Value="formModel.IsActive" />
                        <label class="form-check-label">Aktívne</label>
                    </div>

                    <div class="d-flex gap-2 border-top pt-3">
                        <button type="submit" class="btn btn-primary">Uložiť zmeny</button>
                        <button type="button" class="btn btn-outline-secondary" @onclick='() => Nav.NavigateTo("/")'>Zrušiť</button>
                    </div>
                </EditForm>
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private MealDto? meal;
    private FormModel formModel = new();
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
{
    try
    {
        meal = await MealClient.GetMealAsync(Id);
        
        if (meal != null)
        {
            formModel.Description = meal.Description;
            formModel.Price = meal.Price;
            formModel.IsActive = meal.IsActive;
        }
        else
        {
            errorMessage = "Jedlo nebolo nájdené.";
        }
    }
    catch (Exception ex)
    {
        errorMessage = $"Chyba pri načítaní: {ex.Message}";
    }
}

    private async Task HandleSave()
    {
        errorMessage = null;
        
        try 
        {
            var updatedMeal = new MealDto(Id, formModel.Description, formModel.Price, formModel.IsActive);
            await MealClient.UpdateMealAsync(Id, updatedMeal);
            Nav.NavigateTo("/");
        }
        catch (Exception ex)
        {
            errorMessage = $"Chyba pri ukladaní: {ex.Message}";
            Console.WriteLine(errorMessage);
        }
    }

    private class FormModel 
    {
        public string Description { get; set; } = "";
        public decimal Price { get; set; } = 0;
        public bool IsActive { get; set; } = true;
    }
}