@using Microsoft.AspNetCore.Authentication
<Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>

@implements IDisposable
@code {
    [CascadingParameter] HttpContext? HttpContext { get; set; }
    [Inject] public UTB.Minute.CanteenClient.Services.TokenProvider TokenProvider { get; set; } = default!;
    [Inject] public PersistentComponentState ApplicationState { get; set; } = default!;

    private PersistingComponentStateSubscription _subscription;

    protected override async Task OnInitializedAsync()
    {
        _subscription = ApplicationState.RegisterOnPersisting(PersistToken);

        if (ApplicationState.TryTakeFromJson<string>("access_token", out var restoredToken))
        {
            TokenProvider.AccessToken = restoredToken;
        }
        
        if (string.IsNullOrEmpty(TokenProvider.AccessToken) && HttpContext is not null && HttpContext.User.Identity?.IsAuthenticated == true)
        {
            var token = await Microsoft.AspNetCore.Authentication.AuthenticationHttpContextExtensions.GetTokenAsync(HttpContext, "access_token");
            TokenProvider.AccessToken = token;
        }
    }

    private Task PersistToken()
    {
        if (!string.IsNullOrEmpty(TokenProvider.AccessToken))
        {
            ApplicationState.PersistAsJson("access_token", TokenProvider.AccessToken);
        }
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        _subscription.Dispose();
    }
}
